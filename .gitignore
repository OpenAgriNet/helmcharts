
# macOS
.DS_Store

# Helm dependency artifacts (regenerated by `helm dependency update`)
charts/**/charts/
charts/**/Chart.lock

# ...except for charts vendored from upstream, which are committed WHOLE.
#
# Argo CD renders from a git clone, so a dependency declared in Chart.yaml and
# absent from charts/ fails the render outright -- "found in Chart.yaml, but
# missing in charts/ directory" -- even when its condition is false and it would
# never be installed. There is no `helm dependency build` step in that path.
#
# The directory itself has to be re-included before anything inside it can be:
# git cannot re-include a file whose parent directory is excluded.
!charts/kong/charts/
!charts/kong/charts/**
!charts/kong/Chart.lock
!charts/external-secrets/charts/
!charts/external-secrets/charts/**
!charts/external-secrets/Chart.lock
!charts/reflector/charts/
!charts/reflector/charts/**
!charts/reflector/Chart.lock
*.tgz

# Rendered output
rendered/

# Editor/IDE
.vscode/
.idea/
*.swp


# Local scratch: a standalone registry someone ran by hand, with a real .env in
# it. Not part of this repo, and its .env holds live credentials -- it was
# committed once by a `git add -A` and must not be again.
registry/

# Live credentials, ANYWHERE in the repo.
#
# quick-start/.gitignore already covers its own .env and every .env.* copy of
# it. This is the same rule repo-wide, so a directory added later cannot
# reintroduce the mistake that put registry/.env in history once -- the ignore
# arrives with the directory instead of having to be remembered.
#
# .env.* catches the backup a `cp .env .env.bak` before an edit produces, which
# is the natural thing to do and yields a file holding every live credential.
# The negations keep the placeholder-only templates tracked, since those are the
# documentation of what has to be filled in.
.env
.env.*
!.env.example
!.env.*.example


# Output of scripts/gen-secrets.py. The script defaults to stdout and writes
# 0600 when given --out, but the file it produces holds every credential the
# charts consume -- and `registry/` above is what happens when one of those
# reaches a `git add -A`.
secrets.json
*-secrets.json

# Python bytecode
__pycache__/
*.pyc
