# Real values, and the ports/refs one machine happens to use.
.env

# Private keys. Generated by bin/setup.py, never committed.
keys/

# Rendered from the .tmpl files beside them, and they carry the private key
# material that keys/ holds. The templates are the tracked source.
config/adapters/exp.yaml
config/adapters/network.yaml
config/adapters/provider.yaml

# A local override for the discovery service, if you make one.
config/discovery/instance.yaml
