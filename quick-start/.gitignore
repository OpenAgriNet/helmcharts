# Real values, and the ports/refs one machine happens to use.
.env

# Private keys. Generated by bin/setup.py, never committed.
keys/

# Federation documents, generated by `make host-descriptor`.
.well-known/

# Python's bytecode cache, left behind by running bin/setup.py.
bin/__pycache__/

# Rendered from the .tmpl files beside them, and they carry the private key
# material that keys/ holds. The templates are the tracked source.
config/adapters/consumer.yaml
# The pre-rename name, still produced by an older setup.py and still
# carrying the same private keys.
config/adapters/experience.yaml
config/adapters/exp.yaml
config/adapters/network.yaml
config/adapters/provider.yaml
config/adapters/single-adapter/network-adapter.yaml
config/adapters/multi-adapter/consumer-adapter.yaml
config/adapters/multi-adapter/network-adapter.yaml
config/adapters/multi-adapter/provider-adapter.yaml

# A local override for the discovery service, if you make one.
config/discovery/instance.yaml

# Any copy of .env. The pattern above is an exact match, so a `cp .env
# .env.bak` before an edit -- which is the natural thing to do -- produces a
# file holding every live credential that git will happily offer to commit.
.env.*
!.env.example

# Nginx Proxy Manager keeps its routing table, its account and its
# certificates in the npm-data and npm-letsencrypt volumes, so there is
# nothing here to ignore -- and nothing here to review either. Back those
# volumes up; they are the only copy.

# Signed by `make host-descriptor`, per deployment. Never committed.
.well-known/

# This network's TLS material and the CA copied beside it, from `make certs`.
tls/

# The federation front door, rendered from the .template beside it by
# `make host-descriptor`. The template is the tracked source.
config/reverse-proxy/federation/server.conf
