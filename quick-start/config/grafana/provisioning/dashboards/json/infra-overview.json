              "sort": "desc"
            }
          }
        },
        {
          "id": 12,
          "type": "timeseries",
          "title": "Database connections",
          "description": "Open database connections compared with the maximum allowed. At the maximum, new requests have to wait.",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "gridPos": {
            "x": 12,
            "y": 30,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "clickhouse"
              },
              "editorType": "sql",
              "format": 0,
              "queryType": "sql",
              "pluginVersion": "4.21.3",
              "rawSql": "SELECT time, service, kind, connections\nFROM (\nSELECT time, service, 'in use' AS kind, sum(v) AS connections\nFROM (\n  SELECT $__timeInterval(TimeUnix) AS time, ServiceName AS service,\n         ResourceAttributes['postgresql.database.name'] AS database, max(Value) AS v\n  FROM otel.otel_metrics_sum\n  WHERE $__timeFilter(TimeUnix) AND MetricName = 'postgresql.backends' AND $__conditionalAll(ServiceName IN ($service), $service)\n  GROUP BY time, service, database\n)\nGROUP BY time, service\nUNION ALL\nSELECT $__timeInterval(TimeUnix) AS time, ServiceName AS service, 'maximum' AS kind, max(Value) AS connections\nFROM otel.otel_metrics_gauge\nWHERE $__timeFilter(TimeUnix) AND MetricName = 'postgresql.connection.max' AND $__conditionalAll(ServiceName IN ($service), $service)\nGROUP BY time, service\n)\nORDER BY time"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
