        "query": {
          "refId": "service-variable",
          "editorType": "sql",
          "rawSql": "SELECT DISTINCT ServiceName AS service\nFROM otel.otel_metrics_gauge\nWHERE $__timeFilter(TimeUnix)\n  AND MetricName = 'container.cpu.utilization'\nORDER BY service",
