      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.21.3",
          "rawSql": "SELECT\n  $__timeInterval(TimeUnix) AS time,\n  ServiceName AS service,\n  ResourceAttributes['postgresql.database.name'] AS database,\n  max(Value) AS size\nFROM otel.otel_metrics_sum\nWHERE $__timeFilter(TimeUnix)\n  AND MetricName = 'postgresql.db_size'\n  AND $__conditionalAll(ServiceName IN ($service), $service)\nGROUP BY time, service, database\nORDER BY time"
