    {
      "id": 9,
      "type": "timeseries",
      "title": "Disk I/O",
      "description": "Data read from and written to disk, per second.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.21.3",
          "rawSql": "SELECT time, service, op, sum(bps) AS value\nFROM (\n  SELECT\n    time, service, op,\n    (v - lagInFrame(v) OVER w) / greatest(toUnixTimestamp(time) - toUnixTimestamp(lagInFrame(time) OVER w), 1) AS bps,\n    row_number() OVER w AS rn\n  FROM (\n    SELECT\n      $__timeInterval(TimeUnix) AS time,\n      ServiceName AS service,\n      Attributes['operation'] AS op,\n      concat(Attributes['device_major'], ':', Attributes['device_minor']) AS series,\n      max(Value) AS v\n    FROM otel.otel_metrics_sum\n    WHERE $__timeFilter(TimeUnix)\n      AND MetricName = 'container.blockio.io_service_bytes_recursive' AND Attributes['operation'] IN ('read', 'write')\n      AND $__conditionalAll(ServiceName IN ($service), $service)\n    GROUP BY time, service, op, series\n  )\n  WINDOW w AS (PARTITION BY service, op, series ORDER BY time ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)\n)\nWHERE rn > 1 AND bps >= 0\nGROUP BY time, service, op\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 6,
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "barAlignment": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "displayName": "${__field.labels.service} ${__field.labels.op}"
        },
        "overrides": []
      },
      "options": {
