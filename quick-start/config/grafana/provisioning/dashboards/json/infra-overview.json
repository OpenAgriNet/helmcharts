    {
      "id": 10,
      "type": "timeseries",
      "title": "Database size",
      "description": "Disk space used by each database. This is where stored data grows.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
