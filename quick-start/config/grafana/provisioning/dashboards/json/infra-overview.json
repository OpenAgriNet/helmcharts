                "fillOpacity": 12,
                "gradientMode": "opacity",
                "showPoints": "never",
                "pointSize": 6,
                "spanNulls": true,
                "axisPlacement": "auto",
                "axisSoftMin": 0,
                "barAlignment": 0,
                "scaleDistribution": {
                  "type": "linear"
                },
                "stacking": {
                  "mode": "none",
                  "group": "A"
                },
                "thresholdsStyle": {
                  "mode": "off"
                }
              },
