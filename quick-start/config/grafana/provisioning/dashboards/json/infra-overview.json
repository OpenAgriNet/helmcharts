    {
      "id": 13,
      "type": "row",
      "title": "Network and database",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 11,
          "type": "timeseries",
          "title": "Network I/O",
          "description": "Data received and sent over the network, per second.",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "gridPos": {
            "x": 0,
            "y": 30,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "clickhouse"
              },
              "editorType": "sql",
              "format": 0,
              "queryType": "sql",
              "pluginVersion": "4.21.3",
              "rawSql": "SELECT time, service, direction, sum(bps) AS value\nFROM (\n  SELECT\n    time, service, direction,\n    (v - lagInFrame(v) OVER w) / greatest(toUnixTimestamp(time) - toUnixTimestamp(lagInFrame(time) OVER w), 1) AS bps,\n    row_number() OVER w AS rn\n  FROM (\n    SELECT\n      $__timeInterval(TimeUnix) AS time,\n      ServiceName AS service,\n      if(MetricName = 'container.network.io.usage.rx_bytes', 'in', 'out') AS direction,\n      Attributes['interface'] AS series,\n      max(Value) AS v\n    FROM otel.otel_metrics_sum\n    WHERE $__timeFilter(TimeUnix)\n      AND MetricName IN ('container.network.io.usage.rx_bytes', 'container.network.io.usage.tx_bytes')\n      AND $__conditionalAll(ServiceName IN ($service), $service)\n    GROUP BY time, service, direction, series\n  )\n  WINDOW w AS (PARTITION BY service, direction, series ORDER BY time ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)\n)\nWHERE rn > 1 AND bps >= 0\nGROUP BY time, service, direction\nORDER BY time"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
