    {
      "id": 10,
      "type": "timeseries",
      "title": "Error events by type",
      "description": "The `error` span event, which carries type / code / path / msg. This is the real failure signal -- see the Error rate tile description for why StatusCode is not.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  $__timeInterval(Timestamp) AS time,\n  ev.2['type'] AS error_type,\n  count() AS errors\nFROM otel.otel_traces\nARRAY JOIN arrayZip(Events.Name, Events.Attributes) AS ev\nWHERE $__timeFilter(Timestamp) AND ev.1 = 'error'\nGROUP BY time, error_type\nORDER BY time",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 60,
            "barAlignment": 0,
