    {
      "id": 14,
      "type": "timeseries",
      "title": "Empty-answer share",
      "description": "Discovers that matched nothing, as a percentage. The red line at 50% is a judgement call, not an SLO -- no served-request objective is defined yet.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  $__timeInterval(Timestamp) AS time,\n  100 * countIf(SpanAttributes['result.empty'] = 'true')\n      / countIf(SpanAttributes['result.empty'] != '') AS empty_pct\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp)\n  AND ServiceName = 'discovery-service'\n  AND SpanAttributes['beckn.action'] = 'discover'\nGROUP BY time\nORDER BY time",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "barAlignment": 0,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
