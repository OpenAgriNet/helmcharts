    {
      "id": 15,
      "type": "table",
      "title": "What is being asked for",
      "description": "Requests by capability. beckn.schemaType arrives as a serialised array ([\"openagrinet:MandiPrice\"]); the brackets and prefix are stripped here.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 8,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  replaceRegexpAll(SpanAttributes['beckn.schemaType'], '[\\\\[\\\\]\"]|openagrinet:', '') AS schema_type,\n  count() AS requests,\n  countIf(SpanAttributes['result.empty'] = 'true') AS empty_results,\n  round(100 * countIf(SpanAttributes['result.empty'] = 'true') / count(), 1) AS empty_pct\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp) AND SpanAttributes['beckn.schemaType'] != ''\nGROUP BY schema_type\nORDER BY requests DESC",
          "format": 1,
          "queryType": "sql",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
