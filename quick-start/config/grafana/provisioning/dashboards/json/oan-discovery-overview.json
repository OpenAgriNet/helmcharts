    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "p50 / p95 / p99 of span duration, in milliseconds.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  $__timeInterval(Timestamp) AS time,\n  quantile(0.50)(Duration / 1e6) AS p50,\n  quantile(0.95)(Duration / 1e6) AS p95,\n  quantile(0.99)(Duration / 1e6) AS p99\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp)\n  AND ServiceName = 'discovery-service' AND SpanKind = 'Server'\nGROUP BY time\nORDER BY time",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.21.3"
        }
