        "name": "action",
        "label": "Action",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": {
          "refId": "action-variable",
          "editorType": "sql",
          "rawSql": "SELECT DISTINCT SpanAttributes['beckn.action'] AS action\nFROM otel.otel_traces\nWHERE SpanAttributes['beckn.action'] != ''\nORDER BY action",
          "format": 1,
          "queryType": "sql"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
