{
  "uid": "oan-discovery-overview",
  "title": "OAN Discovery — Service Overview",
  "description": "Rate, errors, duration and answer quality for discovery-service, over the OTel ClickHouse tables. Provisioned from config/grafana/provisioning/dashboards/json -- edits made here are overwritten on the next scan; change the file instead.",
  "tags": [
    "oan",
    "discovery",
    "clickhouse",
    "otel"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
