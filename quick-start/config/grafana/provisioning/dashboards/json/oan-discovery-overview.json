    {
      "id": 6,
      "type": "timeseries",
      "title": "Request rate by action",
      "description": "Server spans per interval, split by beckn.action.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  $__timeInterval(Timestamp) AS time,\n  SpanAttributes['beckn.action'] AS action,\n  count() AS requests\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp)\n  AND ServiceName = 'discovery-service' AND SpanKind = 'Server'\n  AND $__conditionalAll(SpanAttributes['beckn.action'] IN ($action), $action)\nGROUP BY time, action\nORDER BY time",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
