    {
      "id": 8,
      "type": "table",
      "title": "Recent traces",
      "description": "Every span, not just the failed ones -- the browsable list. Click a TraceId to open the waterfall for that request.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  Timestamp AS time,\n  SpanAttributes['beckn.action'] AS action,\n  round(Duration / 1e6, 2) AS duration_ms,\n  SpanAttributes['http.status_code'] AS status,\n  SpanAttributes['result.empty'] AS empty,\n  SpanAttributes['beckn.transactionId'] AS transaction_id,\n  TraceId\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp)\n  AND ServiceName = 'discovery-service' AND SpanKind = 'Server'\n  AND $__conditionalAll(SpanAttributes['beckn.action'] IN ($action), $action)\nORDER BY Timestamp DESC\nLIMIT 200",
          "format": 1,
          "queryType": "sql",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "transaction_id"
            },
            "properties": [
              {
                "id": "links",
