    {
      "id": 19,
      "type": "row",
      "title": "Saturation & Pipeline",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 17,
          "type": "timeseries",
          "title": "Postgres pool acquire-waits",
          "description": "Acquires that had to WAIT because the pool was empty. Rises before anything fails, and is invisible to every layer outside the process -- pg_stat_activity shows established connections, which pgxpool holds open when idle. Cumulative counter, so this is the per-interval increase.",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "gridPos": {
            "x": 0,
            "y": 41,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "clickhouse"
              },
              "editorType": "sql",
              "rawSql": "SELECT\n  time,\n  greatest(0, cum - any(cum) OVER (ORDER BY time ROWS BETWEEN 1 PRECEDING AND 1 PRECEDING)) AS empty_acquires\nFROM (\n  SELECT $__timeInterval(TimeUnix) AS time, max(Value) AS cum\n  FROM otel.otel_metrics_sum\n  WHERE $__timeFilter(TimeUnix) AND MetricName = 'pgxpool.empty_acquire'\n  GROUP BY time\n)\nORDER BY time",
              "format": 0,
              "queryType": "sql",
              "pluginVersion": "4.21.3"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 2,
                "fillOpacity": 12,
                "barAlignment": 0,
                "gradientMode": "none",
                "showPoints": "auto",
                "pointSize": 5,
                "spanNulls": false,
                "axisPlacement": "auto",
                "axisLabel": "",
                "axisSoftMin": 0,
                "scaleDistribution": {
                  "type": "linear"
                },
                "hideFrom": {
                  "legend": false,
                  "tooltip": false,
                  "viz": false
                },
                "insertNulls": false,
                "stacking": {
                  "mode": "none",
                  "group": "A"
                },
                "thresholdsStyle": {
                  "mode": "off"
                }
              },
              "mappings": [],
              "color": {
                "mode": "palette-classic"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "showLegend": true,
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "last",
                "max"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc",
              "hideZeros": false
            }
          },
          "interval": "1m"
        },
        {
          "id": 18,
          "type": "table",
          "title": "Telemetry freshness",
          "description": "Whether to believe the rest of this dashboard. A stale last_seen distinguishes 'traffic stopped' from 'the collector stopped' -- which look identical on every other panel. The collector reads container logs with start_at: end, so anything written while it is down is gone.",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "gridPos": {
            "x": 12,
            "y": 41,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "clickhouse"
              },
              "editorType": "sql",
              "rawSql": "SELECT 'traces' AS signal, max(Timestamp) AS last_seen, count() AS rows_in_range\nFROM otel.otel_traces WHERE $__timeFilter(Timestamp)\nUNION ALL\nSELECT 'logs', max(Timestamp), count() FROM otel.otel_logs WHERE $__timeFilter(Timestamp)\nUNION ALL\nSELECT 'metrics', max(TimeUnix), count() FROM otel.otel_metrics_sum WHERE $__timeFilter(TimeUnix)",
              "format": 1,
              "queryType": "sql",
              "pluginVersion": "4.21.3"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "align": "auto",
                "cellOptions": {
                  "type": "auto"
                },
                "inspect": false,
                "filterable": true
              },
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "text",
                    "value": null
                  }
                ]
              }
            },
