        "hide": 0
      },
      {
        "name": "service",
        "label": "Log service",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": {
          "refId": "service-variable",
          "editorType": "sql",
          "rawSql": "SELECT DISTINCT ServiceName AS service FROM otel.otel_logs ORDER BY service",
