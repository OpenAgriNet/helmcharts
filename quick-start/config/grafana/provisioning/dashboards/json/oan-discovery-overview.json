                  {
                    "title": "Troubleshoot this transaction",
                    "url": "/d/oan-discovery-troubleshoot/oan-discovery-troubleshoot?var-transaction_id=${__data.fields.transaction_id}&var-trace_id=${__data.fields.TraceId}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TraceId"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Troubleshoot this request",
