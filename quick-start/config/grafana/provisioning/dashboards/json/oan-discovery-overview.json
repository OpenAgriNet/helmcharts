    {
      "id": 12,
      "type": "table",
      "title": "Recent failed requests",
      "description": "Click a transaction_id to open the troubleshooting dashboard for that one request. The link carries the dashboard's time range, without which the drill-down opens on its own default window and shows nothing.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  Timestamp AS time,\n  SpanAttributes['beckn.action'] AS action,\n  SpanAttributes['http.status_code'] AS status,\n  ev.2['type'] AS error_type,\n  ev.2['code'] AS error_code,\n  ev.2['msg'] AS message,\n  SpanAttributes['beckn.transactionId'] AS transaction_id,\n  TraceId\nFROM otel.otel_traces\nARRAY JOIN arrayZip(Events.Name, Events.Attributes) AS ev\nWHERE $__timeFilter(Timestamp) AND ev.1 = 'error'\nORDER BY Timestamp DESC\nLIMIT 100",
          "format": 1,
          "queryType": "sql",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "transaction_id"
            },
            "properties": [
              {
                "id": "links",
