        {
          "id": 20,
          "type": "logs",
          "title": "Container logs",
          "description": "stdout from every container in the stack, not just discovery-service. Only Go services have a parsed SeverityText -- Keycloak and Postgres lines arrive with an empty level, so a severity filter would silently hide them.",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "gridPos": {
            "x": 0,
            "y": 41,
            "w": 24,
            "h": 12
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "clickhouse"
              },
              "editorType": "sql",
              "rawSql": "SELECT\n  Timestamp AS timestamp,\n  Body AS body,\n  SeverityText AS level,\n  ServiceName,\n  TraceId\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND $__conditionalAll(ServiceName IN ($service), $service)\nORDER BY Timestamp DESC\nLIMIT 500",
              "format": 2,
              "queryType": "sql",
              "pluginVersion": "4.21.3"
            }
          ],
          "options": {
            "showTime": true,
