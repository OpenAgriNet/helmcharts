    {
      "id": 11,
      "type": "table",
      "title": "Errors by type and code",
      "description": "Where failures concentrate. `path` is the JSONPath of the offending field for envelope rejections.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  ev.2['type'] AS error_type,\n  ev.2['code'] AS error_code,\n  ev.2['path'] AS path,\n  count() AS errors\nFROM otel.otel_traces\nARRAY JOIN arrayZip(Events.Name, Events.Attributes) AS ev\nWHERE $__timeFilter(Timestamp) AND ev.1 = 'error'\nGROUP BY error_type, error_code, path\nORDER BY errors DESC",
          "format": 1,
          "queryType": "sql",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "errors"
            },
