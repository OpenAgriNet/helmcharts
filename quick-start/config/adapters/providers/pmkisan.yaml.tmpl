          # One step for both of PM-KISAN's capabilities: the OTP taken for a
          # SchemeApplication is what a Grievance then presents, so they share.
          - id: Grievance
            config:
              bindingKeys: "__BINDING_KEY__"
              providerIdAt: "message.contract.commitments[].offer.provider.id, message.support.channels[].provider.id"
              capabilityCodeAt: "message.contract.commitments[].commitmentAttributes.@type, message.support.channels[].@type"
              __PARTICIPANT_ID__:
                authScheme: none
              "__PARTICIPANT_ID__|openagrinet:Grievance":
                envelope: aesGcm
                envelopeKeyEnv: PMKISAN_GRIEVANCE_KEY
                envelopeNonceEnv: PMKISAN_GRIEVANCE_IV
                envelopeTokenEnv: PMKISAN_SERVICE_TOKEN
                envelopeTokenField: TokenNo
                envelopeRequestField: EncryptedRequest
                envelopeResponsePaths: "d.output,output"
                otpEnvelope: aesCbcKeyInBand
                otpBindingKey: "__PARTICIPANT_ID__|openagrinet:SchemeApplication"
                otpTokenEnv: PMKISAN_OTP_TOKEN
                otpTokenField: Token
                otpRequestField: EncryptedRequest
                otpResponsePaths: "d.output,output"
                otpActions: init
                otpVerifyPath: /ChatbotOTPVerified
                otpVerifyActions: "support,status"
                otpVerifyTimeoutMs: "10000"
              "__PARTICIPANT_ID__|openagrinet:SchemeApplication":
                envelope: aesCbcKeyInBand
                envelopeTokenEnv: PMKISAN_OTP_TOKEN
                envelopeTokenField: Token
                envelopeRequestField: EncryptedRequest
                envelopeResponsePaths: "d.output,output"
                otpVerifyPath: /ChatbotOTPVerified
                otpVerifyActions: status
                otpVerifyTimeoutMs: "10000"
                followUpPath: /ChatbotBeneficiaryStatus
                followUpField: _beneficiaryStatus
                followUpActions: status
                followUpTimeoutMs: "10000"
