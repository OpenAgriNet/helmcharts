__PROVIDER_CONFIG__ AgricultureResource
              # GFR's soil test needs SHC's login: the refresh token is traded for a
              # 7-day access token, sent as "Bearer <token>". The recommendation ignores it.
              __PARTICIPANT_ID__:
                authScheme: tokenHeader
                tokenUrl: "__GFR_TOKEN_URL__"
                tokenRequestBody: '{"query":"query Query($refreshToken: String!) { generateAccessToken(refreshToken: $refreshToken) }"}'
                tokenSecretField: variables.refreshToken
                tokenSecretEnv: GFR_REFRESH_TOKEN
                tokenResponseField: data.generateAccessToken.token
                tokenTtl: 144h
                headerName: Authorization
                tokenHeaderPrefix: Bearer
