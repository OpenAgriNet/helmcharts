__PROVIDER_CONFIG__ Grievance
              # No OTP and no envelope, but not credential-free: the call
              # carries a token exchanged at PMFBY's own login, held until the
              # login reply's validTo and sent bare in Authorization. Ported
              # from charts/adapter-service/config/single-adapter/
              # network-adapter-config.yaml, which is the deployed source.
              __PARTICIPANT_ID__:
                authScheme: tokenHeader
                tokenUrl: "__PMFBY_TOKEN_URL__"
                tokenUserField: appAccessUID
                tokenUserEnv: PMFBY_ACCESS_UID
                tokenSecretField: appAccessPWD
                tokenSecretEnv: PMFBY_ACCESS_PWD
                tokenResponseField: responseDynamic.token.Token
                tokenExpiryField: responseDynamic.token.validTo
                headerName: Authorization
              # The insurance reads are the farmer's, not the service's. The
              # OTP answered on confirm buys a session; policy and claim both
              # spend it. Held in the cache against the transaction, never
              # returned on the wire.
              #
              # What is held is the farmerID PMFBY resolved from the mobile.
              # It is a session token in the sense that matters here -- it is
              # what the reads cannot be made without, and it only exists once
              # the OTP was answered -- but it is NOT a bearer, so it goes in
              # a header of its own rather than Authorization, which already
              # carries the service's own login token.
              "__PARTICIPANT_ID__|openagrinet:SchemeApplication":
                sessionKeyAt: "context.transactionId,context.transaction_id"
                sessionCaptureOn: confirm
                sessionSendOn: "status,select"
                sessionTokenField: data.farmerID
                # PMFBY states no lifetime on verifyMobile, so this is the
                # whole of it, less the slack that keeps a session from being
                # spent in the second it expires.
                sessionTtl: 15m
                sessionTtlMargin: 60s
                # The session was bought for one mobile number. Without this a
                # transaction id is enough to read another farmer's policies.
                sessionBindAt: "message.contract.commitments[].commitmentAttributes.mobile"
                sessionHeader: X-PMFBY-Farmer-Session
                sessionPrefix: ""
              # The grievance filing is the farmer's too. The OTP answered on
              # confirm buys a session; support spends it. Same NIC endpoints
              # and the same farmerID as the insurance binding above, held in
              # its own entry because a session belongs to one capability.
              #
              # Unlike insurance, nothing downstream wants the value --
              # AddKRPHNCIPGrievenceSupportTicket takes no farmer id. It is
              # sent anyway, in a header PMFBY ignores, because sending it is
              # how the adapter is asked to REQUIRE it: a support call that
              # answered no OTP, or answered one for another number, is then
              # refused here rather than by a check in the tool.
              "__PARTICIPANT_ID__|openagrinet:Grievance":
                sessionKeyAt: "context.transactionId,context.transaction_id"
                sessionCaptureOn: confirm
                sessionSendOn: support
                sessionTokenField: data.farmerID
                # PMFBY states no lifetime on verifyMobile. An hour, as KHC
                # has it: long enough for a farmer to describe a problem,
                # short enough that an abandoned verification does not stay
                # spendable all day.
                sessionTtl: 1h
                sessionTtlMargin: 60s
                # The session was bought for one mobile number. Two paths
                # because the two calls are two of PMFBY's own endpoints and it
                # names the field differently on each: mobile on the
                # verifyMobile a contract carries, and requestorMobileNo on the
                # filing a channel carries.
                sessionBindAt: "message.contract.commitments[].commitmentAttributes.mobile,message.support.channels[].requestorMobileNo"
                sessionHeader: X-PMFBY-Farmer-Session
                sessionPrefix: ""
