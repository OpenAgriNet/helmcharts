# OAN network adapter. The network layer: hands discovery to the discovery
# service and re-signs as itself on the way out.
appName: "network-adapter"

log:
  level: debug
  destinations:
    - type: stdout
  contextKeys: [transaction_id, message_id, subscriber_id, module_id]

http:
  port: 9201
  timeout:
    read: 30
    write: 30
    idle: 30

pluginManager:
  root: ./plugins

plugins:
  # Ships metrics, traces and logs over OTLP/gRPC. All three flags false builds
  # no exporter at all, which is the right setting for a stack with no collector.
  otelsetup:
    id: otelsetup
    config:
      serviceName: "network-adapter"
      environment: "__OTEL_ENVIRONMENT__"
      otlpEndpoint: "__OTLP_ENDPOINT__"
      enableMetrics: "__OTEL_ENABLED__"
      enableTracing: "__OTEL_ENABLED__"
      enableLogs: "__OTEL_ENABLED__"

  # -------------------------------------------------------------------------
  # Scheduled catalog publishing (the catalogcrawler's publish sweep).
  #
  # Application-level, like otelsetup: started once at boot, not per request.
  # On every tick it lists the registry's bindings, keeps the ones whose
  # `publish` action names a pipeline URL (bin/add-publish-action.py adds it),
  # and runs each pipeline that is due: fetch the upstream, build the catalogs,
  # POST each to the provider adapter's /publish, which signs it and routes it
  # back through this adapter to discovery. The pipeline's inputs (MANDI_*) come
  # from this container's environment, set in docker-compose.yml.
  #
  # This registry block is the CRAWLER's own lookup; the module's
  # plugins.registry below is separate and unchanged.
  registry:
    id: sunbirdRegistry
    config:
      url: http://sunbird-registry-service:8081/api/v1
      entity: Participant
      providerEntity: ProviderSchema

  crawler:
    id: catalogcrawler
    config:
      # The run log. Its own database on the discovery Postgres, created by
      # config/discovery/initdb/ on a fresh volume (or by hand: see README).
      dbDsn: "postgres://discovery:discovery@discovery-postgres:5432/catalogcrawler?sslmode=disable"
      # Where built catalogs are POSTed: the provider adapter's /publish.
      discoveryPushUrl: "http://provider-adapter:9200/publish"
      # Who the catalogs are published AS and TO (context.senderId / receiverId).
      participantId: "__PROVIDER_PUBLISH_ID__"
      receiverId: "__DISCOVERY_PUBLISH_ID__"
      publishPipelines: "true"
      publishEnabled: "true"
      # One cadence for catalog sync and the publish sweep. 60 s so clearing the
      # run log re-runs a pipeline within a minute; use 3600 for anything longer
      # lived (a pipeline due at 13:00 then starts between 13:00 and 14:00).
      catalogIntervalSeconds: "60"
      publishCatalogOutputDir: "/tmp/catalogs"
      # Per-pipeline overrides, by the pipeline's metadata.name. The Agmarknet
      # upstream's data lags 1-3 weeks and states report in bursts, so the
      # pipeline's default window (yesterday) usually returns nothing: ask for
      # a relative window instead of a fixed date.
      publish.mandi-price.schedule: "0 13 * * *"
      publish.mandi-price.fromDate: "21 days ago"

modules:
  - name: network-adapter
    # A subtree: every action lands here and the payload says which one it is.
    path: /
    handler:
      type: std
      # bpp because this adapter RECEIVES. role sets direction, not participant type.
      role: bpp
      subscriberId: __NETWORK_SUBSCRIBER_ID__

      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            # 0 because no cache plugin is configured. A non-zero TTL here only
            # warns at startup and caches nothing.
            cacheTTL: 0
            # Plain seconds, per attempt.
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            # A search response past this is refused, not truncated.
            maxResponseBytes: 1048576

        keyManager:
          id: simplekeymanager
          config:
            subscriberId: __NETWORK_SUBSCRIBER_ID__
            # The key's osid, not a friendly name: the registry indexes on it.
            keyId: __NETWORK_KEY_ID__
            signingPrivateKey: "__NETWORK_SIGNING_PRIVATE__"
            signingPublicKey: "__NETWORK_SIGNING_PUBLIC__"
            encrPrivateKey: "__NETWORK_ENCR_PRIVATE__"
            encrPublicKey: "__NETWORK_ENCR_PUBLIC__"

        signer:
          id: signer
        signValidator:
          id: signvalidator

        # Populates transaction_id and message_id on the context so every log
        # line carries them. subscriber_id is resolved separately, not listed.
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transaction_id,message_id
              role: bpp

        # The extended layer is off: it fetches a resource's own @context per
        # payload, and nothing here needs it. The settings below only apply if
        # it is turned on.
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: "https://raw.githubusercontent.com/beckn/protocol-specifications-v2/refs/tags/core-v2.0.0-lts/api/v2.0.0/beckn.yaml"
            cacheTTL: "3600"
            extendedSchema_enabled: "false"
            extendedSchema_cacheTTL: "86400"
            extendedSchema_maxCacheSize: "100"
            extendedSchema_downloadTimeout: "30"
            extendedSchema_allowedDomains: "raw.githubusercontent.com,schema.beckn.io,schema.nfh.global,openagrinet.github.io"

        router:
          id: router
          config:
            routingConfig: /app/config/routing-network.yaml

      # Signing and signature validation are OFF: this tier accepts unsigned
      # traffic and forwards unsigned. Turning it back on means adding the step
      # names here AND on the other side of the hop at the same time.
      #
      # validateSchema is not listed either, so this tier enforces no payload
      # shape at all -- it only routes.
      steps:
        - addRoute
