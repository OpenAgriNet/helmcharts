# The DSS's own adapter. /dss/ checks who calls the DSS and hands the turn on;
# /consumer/ signs what the DSS sends to the network. setup.py renders it.
appName: "dss-adapter"

log:
  level: debug
  destinations:
    - type: stdout
  contextKeys: [transaction_id, message_id, subscriber_id, module_id]

http:
  port: 9204
  timeout:
    read: 30
    # A DSS turn is streamed and may stay quiet for up to two minutes, so the
    # reply has to be allowed to outlast the usual 30.
    write: 180
    idle: 30

pluginManager:
  root: ./plugins

plugins:
  otelsetup:
    id: otelsetup
    config:
      serviceName: "dss-adapter"
      environment: "__OTEL_ENVIRONMENT__"
      otlpEndpoint: "__OTLP_ENDPOINT__"
      enableMetrics: "__OTEL_ENABLED__"
      enableTracing: "__OTEL_ENABLED__"
      enableLogs: "__OTEL_ENABLED__"

modules:
  # Inbound: the experience layer calling the DSS. Only a participant the
  # registry knows, signing with its registered key, gets through.
  - name: dss-adapter-inbound
    path: /dss/
    handler:
      type: std
      role: bpp
      subscriberId: __DSS_SUBSCRIBER_ID__
      # The DSS answers as an event stream; hold none of it back.
      streamResponses: true
      httpClientConfig:
        maxIdleConns: 100
        maxIdleConnsPerHost: 20
        idleConnTimeout: 300s
        # How long the DSS may take to start answering.
        responseHeaderTimeout: 130s

      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            cacheTTL: 0
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            maxResponseBytes: 1048576

        keyManager:
          id: simplekeymanager
          config:
            subscriberId: __DSS_SUBSCRIBER_ID__
            keyId: __DSS_KEY_ID__
            signingPrivateKey: "__DSS_SIGNING_PRIVATE__"
            signingPublicKey: "__DSS_SIGNING_PUBLIC__"
            encrPrivateKey: "__DSS_ENCR_PRIVATE__"
            encrPublicKey: "__DSS_ENCR_PUBLIC__"

        signer:
          id: signer
        signValidator:
          id: signvalidator

        router:
          id: nonbecknrouter
          config:
            routingConfig: /app/config/routing-dss-inbound.yaml

      # No checkCrossNetworkRequester: that judges another network's request,
      # and this door is not one.
      steps:
        - validateSign
        - addRoute

  # Outbound: the DSS calling the network. The DSS sends these unsigned, as the
  # consumer app does, and the network layer checks the signature added here.
  - name: dss-adapter-outbound
    path: /consumer/
    handler:
      type: std
      role: bap
      subscriberId: __DSS_SUBSCRIBER_ID__
      httpClientConfig:
        maxIdleConns: 100
        maxIdleConnsPerHost: 20
        idleConnTimeout: 300s
        # How long the network may take to start answering.
        responseHeaderTimeout: 30s

      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            cacheTTL: 0
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            maxResponseBytes: 1048576

        keyManager:
          id: simplekeymanager
          config:
            subscriberId: __DSS_SUBSCRIBER_ID__
            keyId: __DSS_KEY_ID__
            signingPrivateKey: "__DSS_SIGNING_PRIVATE__"
            signingPublicKey: "__DSS_SIGNING_PUBLIC__"
            encrPrivateKey: "__DSS_ENCR_PRIVATE__"
            encrPublicKey: "__DSS_ENCR_PUBLIC__"

        signer:
          id: signer
        signValidator:
          id: signvalidator

        # Puts transaction_id and message_id on every log line.
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transaction_id,message_id
              role: bap

        router:
          id: router
          config:
            routingConfig: /app/config/routing-dss-outbound.yaml

      # The layers behind this check the signature, and the provider layer the
      # schema, so only route and sign here.
      steps:
        - addRoute
        - sign
