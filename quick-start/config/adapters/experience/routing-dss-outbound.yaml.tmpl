# DSS adapter, outbound: discover goes to the network, every other action a caller
# sends goes to the provider. setup.py fills in the two URLs.
routingRules:
  - version: "2.0.0"
    targetType: "url"
    target:
      url: "__NETWORK_URL__"
    endpoints:
      - discover

  - version: "2.0.0"
    targetType: "url"
    target:
      url: "__PROVIDER_URL__"
    endpoints:
      - select
      - init
      - confirm
      - status
      - track
      - update
      - cancel
      - rate
      - support
