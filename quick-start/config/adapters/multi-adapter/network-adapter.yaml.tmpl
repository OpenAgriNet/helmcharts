# Use only in multi-adapter deployment mode: the network adapter,
# the network layer: hands discovery to the discovery service, re-signs as itself.
appName: "network-adapter"

log:
  level: debug
  destinations:
    - type: stdout
  contextKeys: [transaction_id, message_id, subscriber_id, module_id]

http:
  port: 9201
  timeout:
    read: 30
    write: 30
    idle: 30

pluginManager:
  root: ./plugins

plugins:
  # Ships metrics, traces and logs over OTLP/gRPC. All three flags false builds
  # no exporter at all, which is the right setting for a stack with no collector.
  otelsetup:
    id: otelsetup
    config:
      serviceName: "network-adapter"
      environment: "__OTEL_ENVIRONMENT__"
      otlpEndpoint: "__OTLP_ENDPOINT__"
      enableMetrics: "__OTEL_ENABLED__"
      enableTracing: "__OTEL_ENABLED__"
      enableLogs: "__OTEL_ENABLED__"

  # The crawler's OWN registry, separate from the modules' below. It is key
  # distribution for verifying what a crawl fetches, not request handling, and
  # the crawler refuses to start without it.
  registry:
    id: sunbirdRegistry
    config:
      url: http://sunbird-registry-service:8081/api/v1
      entity: Participant
      providerEntity: ProviderSchema
      cacheTTL: 0
      timeout: 2
      retry_max: 1
      retry_wait_min: 100ms
      retry_wait_max: 500ms
      maxResponseBytes: 1048576

  # The crawler: a background pass, not something a request reaches.
  # No dbDsn -- nothing here keeps a record between runs.
  crawler:
    id: catalogcrawler
    config:
      # The provider adapter's /publish mount, which signs a crawled catalog and
      # forwards it on. Not /network/publish: that expects a signature we have none of.
      discoveryPushUrl: "__DISCOVERY_PUSH_URL__"
      participantId: "__NETWORK_SUBSCRIBER_ID__"

      # Off means this network never crawls. It still ANSWERS another network's
      # crawl, which is the network module's job and unaffected by this.
      federationEnabled: "__FEDERATION_ENABLED__"
      signingPrivateKey: "__NETWORK_SIGNING_PRIVATE__"
      keyId: "__NETWORK_KEY_ID__"
      # How often every admitted network is asked.
      federationRefreshSeconds: "__FEDERATION_REFRESH_SECONDS__"
      # How many catalogs one call asks for. Discovery's own default is 20, so
      # without this a network sharing more is only partly collected and
      # nothing says so.
      federationPageSize: "__FEDERATION_PAGE_SIZE__"
      # What breadth of another network's catalogue to ask for. Required in
      # practice: discovery refuses an intent that narrows nothing, so leaving
      # it unset mirrors zero catalogs with no error anywhere.
      federationIntent: '__FEDERATION_INTENT__'

modules:
  - name: network-adapter
    # A subtree: every action lands here and the payload says which one it is.
    path: /network/
    handler:
      type: std
      # bpp because this adapter RECEIVES. role sets direction, not participant type.
      role: bpp
      subscriberId: __NETWORK_SUBSCRIBER_ID__

      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            # 0 because no cache plugin is configured. A non-zero TTL here only
            # warns at startup and caches nothing.
            cacheTTL: 0
            # Plain seconds, per attempt.
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            # A search response past this is refused, not truncated.
            maxResponseBytes: 1048576

        keyManager:
          id: simplekeymanager
          config:
            subscriberId: __NETWORK_SUBSCRIBER_ID__
            # The key's osid, not a friendly name: the registry indexes on it.
            keyId: __NETWORK_KEY_ID__
            signingPrivateKey: "__NETWORK_SIGNING_PRIVATE__"
            signingPublicKey: "__NETWORK_SIGNING_PUBLIC__"
            encrPrivateKey: "__NETWORK_ENCR_PRIVATE__"
            encrPublicKey: "__NETWORK_ENCR_PUBLIC__"

        signer:
          id: signer
        signValidator:
          id: signvalidator

        # Populates transaction_id and message_id on the context so every log
        # line carries them. subscriber_id is resolved separately, not listed.
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transaction_id,message_id
              role: bpp

        # The extended layer is off: it fetches a resource's own @context per
        # payload, and nothing here needs it. The settings below only apply if
        # it is turned on.
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: "https://raw.githubusercontent.com/beckn/protocol-specifications-v2/refs/tags/core-v2.0.0-lts/api/v2.0.0/beckn.yaml"
            cacheTTL: "3600"
            extendedSchema_enabled: "false"
            extendedSchema_cacheTTL: "86400"
            extendedSchema_maxCacheSize: "100"
            extendedSchema_downloadTimeout: "30"
            extendedSchema_allowedDomains: "raw.githubusercontent.com,schema.beckn.io,schema.nfh.global,openagrinet.github.io"

        router:
          id: router
          config:
            routingConfig: /app/config/routing-network.yaml

      # A door: checks the signature and the agreement, then routes. No
      # validateSchema -- the tier that answers does that.
      steps:
        - validateSign
        - checkCrossNetworkRequester
        - addRoute
