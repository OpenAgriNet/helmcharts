# Use only in single-adapter deployment mode: consumer, network and provider tiers in one
# process. Signing is off: keep :9201 on 127.0.0.1. setup.py renders it (ADR-0001).
appName: network-adapter

log:
  level: debug
  destinations:
    - type: stdout
  contextKeys:
    - transaction_id
    - message_id
    - subscriber_id
    - module_id

http:
  port: 9201
  timeout:
    read: 30
    write: 30
    idle: 30

pluginManager:
  root: ./plugins

plugins:
  otelsetup:
    id: otelsetup
    config:
      serviceName: network-adapter
      environment: "__OTEL_ENVIRONMENT__"
      otlpEndpoint: "__OTLP_ENDPOINT__"
      enableMetrics: "__OTEL_ENABLED__"
      enableTracing: "__OTEL_ENABLED__"
      enableLogs: "__OTEL_ENABLED__"

  # The crawler's OWN registry, separate from the modules' below. It is key
  # distribution for verifying what a crawl fetches, not request handling, and
  # the crawler refuses to start without it.
  registry:
    id: sunbirdRegistry
    config:
      url: http://sunbird-registry-service:8081/api/v1
      entity: Participant
      providerEntity: ProviderSchema
      cacheTTL: 0
      timeout: 2
      retry_max: 1
      retry_wait_min: 100ms
      retry_wait_max: 500ms
      maxResponseBytes: 1048576

  # The crawler: a background pass, not something a request reaches.
  # No dbDsn -- nothing here keeps a record between runs.
  crawler:
    id: catalogcrawler
    config:
      # The /publish mount, which signs a crawled catalog and forwards it on.
      # Not /network/publish: that one expects a signature the crawl has none of.
      discoveryPushUrl: "__DISCOVERY_PUSH_URL__"
      participantId: "__NETWORK_SUBSCRIBER_ID__"

      # Off means this network never crawls. It still ANSWERS another network's
      # crawl, which is the network module's job and unaffected by this.
      federationEnabled: "__FEDERATION_ENABLED__"
      signingPrivateKey: "__NETWORK_SIGNING_PRIVATE__"
      keyId: "__NETWORK_KEY_ID__"
      # How often every admitted network is asked.
      federationRefreshSeconds: "__FEDERATION_REFRESH_SECONDS__"
      # How many catalogs one call asks for. Discovery's own default is 20, so
      # without this a network sharing more is only partly collected and
      # nothing says so.
      federationPageSize: "__FEDERATION_PAGE_SIZE__"
      # What breadth of another network's catalogue to ask for. Required in
      # practice: discovery refuses an intent that narrows nothing, so leaving
      # it unset mirrors zero catalogs with no error anywhere.
      federationIntent: '__FEDERATION_INTENT__'

modules:
  # consumer-adapter: our own app, never another network's. Checks no
  # signature, so the edge never exposes it.
  - name: consumer-adapter
    path: /consumer/
    handler:
      type: std
      role: bap
      subscriberId: "__CONSUMER_SUBSCRIBER_ID__"
      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            cacheTTL: 0
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            maxResponseBytes: 1048576
        keyManager:
          id: simplekeymanager
          config:
            subscriberId: "__CONSUMER_SUBSCRIBER_ID__"
            keyId: "__CONSUMER_KEY_ID__"
            signingPrivateKey: "__CONSUMER_SIGNING_PRIVATE__"
            signingPublicKey: "__CONSUMER_SIGNING_PUBLIC__"
            encrPrivateKey: "__CONSUMER_ENCR_PRIVATE__"
            encrPublicKey: "__CONSUMER_ENCR_PUBLIC__"
        signer:
          id: signer
        signValidator:
          id: signvalidator
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transaction_id,message_id
              role: bap
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: https://raw.githubusercontent.com/OpenAgriNet/protocol-specifications-v2/refs/heads/release-0.2.0/api/v2.0.0/beckn.yaml
            cacheTTL: '3600'
            extendedSchema_enabled: "false"
            extendedSchema_cacheTTL: '86400'
            extendedSchema_maxCacheSize: '100'
            extendedSchema_downloadTimeout: '30'
            extendedSchema_allowedDomains: raw.githubusercontent.com,schema.beckn.io,schema.nfh.global,openagrinet.github.io
        router:
          id: router
          config:
            routingConfig: /app/config/routing-network-adapter-consumer.yaml
      steps:
        - validateSchema
        - addRoute
        - sign

  # network-adapter: the door another network calls. Checks the signature and
  # the agreement, then forwards discover and publish to discovery.
  - name: network-adapter
    path: /network/
    handler:
      type: std
      role: bpp
      subscriberId: "__NETWORK_SUBSCRIBER_ID__"
      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            cacheTTL: 0
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            maxResponseBytes: 1048576
        keyManager:
          id: simplekeymanager
          config:
            subscriberId: "__NETWORK_SUBSCRIBER_ID__"
            keyId: "__NETWORK_KEY_ID__"
            signingPrivateKey: "__NETWORK_SIGNING_PRIVATE__"
            signingPublicKey: "__NETWORK_SIGNING_PUBLIC__"
            encrPrivateKey: "__NETWORK_ENCR_PRIVATE__"
            encrPublicKey: "__NETWORK_ENCR_PUBLIC__"
        signer:
          id: signer
        signValidator:
          id: signvalidator
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transaction_id,message_id
              role: bpp
        # Extended layer off: it fetches each resource's @context per payload.
        # The extendedSchema_* settings apply only when it is on.
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: "https://raw.githubusercontent.com/OpenAgriNet/protocol-specifications-v2/refs/heads/release-0.2.0/api/v2.0.0/beckn.yaml"
            cacheTTL: "3600"
            extendedSchema_enabled: "false"
            extendedSchema_cacheTTL: "86400"
            extendedSchema_maxCacheSize: "100"
            extendedSchema_downloadTimeout: "30"
            extendedSchema_allowedDomains: "raw.githubusercontent.com,schema.beckn.io,schema.nfh.global,openagrinet.github.io"
        router:
          id: router
          config:
            routingConfig: /app/config/routing-network.yaml
      steps:
        - validateSign
        - checkCrossNetworkRequester
        - addRoute

  # oanProvider: another network's select lands here. Checks the signature and
  # the agreement, then answers from the upstream APIs.
  - name: oanProvider
    path: /provider/
    handler:
      type: std
      role: bpp
      subscriberId: "__PROVIDER_SUBSCRIBER_ID__"
      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            cacheTTL: 0
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            maxResponseBytes: 1048576
        keyManager:
          id: simplekeymanager
          config:
            subscriberId: "__PROVIDER_SUBSCRIBER_ID__"
            keyId: "__PROVIDER_KEY_ID__"
            signingPrivateKey: "__PROVIDER_SIGNING_PRIVATE__"
            signingPublicKey: "__PROVIDER_SIGNING_PUBLIC__"
            encrPrivateKey: "__PROVIDER_ENCR_PRIVATE__"
            encrPublicKey: "__PROVIDER_ENCR_PUBLIC__"
        signValidator:
          id: signvalidator
        signer:
          id: signer
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transaction_id,message_id
              role: bpp
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: https://raw.githubusercontent.com/OpenAgriNet/protocol-specifications-v2/refs/heads/release-0.2.0/api/v2.0.0/beckn.yaml
            cacheTTL: '3600'
            extendedSchema_enabled: "true"
            extendedSchema_allowedDomains: raw.githubusercontent.com,schema.beckn.io,schema.nfh.global,openagrinet.github.io
            extendedSchema_cacheTTL: '86400'
            extendedSchema_maxCacheSize: '100'
            extendedSchema_downloadTimeout: '30'
        mapper:
          id: jsonmapper
          config:
            fetchTimeout: 10s
            cacheTTL: 1m
            negativeTTL: 1m
            maxMappingBytes: 262144
            maxCacheEntries: 200
        # One per provider the registry holds a binding for, assembled from
        # config/adapters/providers/<provider>.yaml.tmpl.
        providerSteps:
__PROVIDER_STEPS__
      steps:
        - validateSign
        - checkCrossNetworkRequester
        - validateSchema
__PROVIDER_STEP_IDS__
        - sign

  # oanProviderPublish: the catalogue publishes at /publish; routed to
  # /network/publish (routing-network-adapter-provider.yaml).
  - name: oanProviderPublish
    path: /publish
    handler:
      type: std
      role: bap
      subscriberId: "__PROVIDER_SUBSCRIBER_ID__"
      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            cacheTTL: 0
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            maxResponseBytes: 1048576
        keyManager:
          id: simplekeymanager
          config:
            subscriberId: "__PROVIDER_SUBSCRIBER_ID__"
            keyId: "__PROVIDER_KEY_ID__"
            signingPrivateKey: "__PROVIDER_SIGNING_PRIVATE__"
            signingPublicKey: "__PROVIDER_SIGNING_PUBLIC__"
            encrPrivateKey: "__PROVIDER_ENCR_PRIVATE__"
            encrPublicKey: "__PROVIDER_ENCR_PUBLIC__"
        signer:
          id: signer
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transaction_id,message_id
              role: bap
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: https://raw.githubusercontent.com/OpenAgriNet/protocol-specifications-v2/refs/heads/release-0.2.0/api/v2.0.0/beckn.yaml
            cacheTTL: '3600'
            extendedSchema_enabled: "true"
            extendedSchema_allowedDomains: raw.githubusercontent.com,schema.beckn.io,schema.nfh.global,openagrinet.github.io
            extendedSchema_cacheTTL: '86400'
            extendedSchema_maxCacheSize: '100'
            extendedSchema_downloadTimeout: '30'
        router:
          id: router
          config:
            routingConfig: /app/config/routing-network-adapter-provider.yaml
      steps:
        - validateSchema
        - addRoute
        - sign
