# Use only in single-adapter deployment mode: consumer, network and provider tiers in one
# process. Signing is off: keep :9201 on 127.0.0.1. setup.py renders it (ADR-0001).
appName: network-adapter

log:
  level: debug
  destinations:
    - type: stdout
  contextKeys:
    - transaction_id
    - message_id
    - subscriber_id
    - module_id

http:
  port: 9201
  timeout:
    read: 30
    write: 30
    idle: 30

pluginManager:
  root: ./plugins

plugins:
  otelsetup:
    id: otelsetup
    config:
      serviceName: network-adapter
      environment: "__OTEL_ENVIRONMENT__"
      otlpEndpoint: "__OTLP_ENDPOINT__"
      enableMetrics: "__OTEL_ENABLED__"
      enableTracing: "__OTEL_ENABLED__"
      enableLogs: "__OTEL_ENABLED__"

  # Scheduled catalog publishing: the crawler runs each registry binding's
  # `publish` pipeline when due and POSTs the catalogs to /publish (README,
  # Appendix O). This registry block is the crawler's own lookup.
  registry:
    id: sunbirdRegistry
    config:
      url: http://sunbird-registry-service:8081/api/v1
      entity: Participant
      providerEntity: ProviderSchema

  crawler:
    id: catalogcrawler
    config:
      dbDsn: "postgres://crawler:crawler@crawler-postgres:5432/catalogcrawler?sslmode=disable"
      # Where built catalogs are POSTed: this process's own /publish module.
      discoveryPushUrl: "http://localhost:9201/publish"
      # Who the catalogs are published AS (context.senderId) and TO (receiverId).
      participantId: "__PROVIDER_SUBSCRIBER_ID__"
      receiverId: "discovery.oan.dev"
      publishPipelines: "true"
      publishEnabled: "true"
      catalogIntervalSeconds: "60"
      publishCatalogOutputDir: "/tmp/catalogs"
      # Once a day, OnDemand catalogs only (no Direct price catalogs).
      publish.mandi-price.schedule: "0 13 * * *"
      publish.mandi-price.mode: "onDemand"
      # Agmarknet data lags 1-3 weeks: a relative window, not the default (yesterday).
      publish.mandi-price.fromDate: "21 days ago"
      # The pipeline's non-secret inputs, from the Agmarknet values in .env.
      # networkId is required: the network the catalogs are visible to.
      publish.mandi-price.baseUrl: "__AGMARKNET_BASE_URL__"
      publish.mandi-price.participantId: "__AGMARKNET_PARTICIPANT_ID__"
      publish.mandi-price.networkId: "__BECKN_NETWORK_ID__"

modules:
  # consumer-adapter: the app calls /<action>; discover to /_internal/network, transactions
  # to /_internal/provider (routing-network-adapter-consumer.yaml).
  - name: consumer-adapter
    path: /
    handler:
      type: std
      role: bap
      subscriberId: "__CONSUMER_SUBSCRIBER_ID__"
      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            cacheTTL: 0
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            maxResponseBytes: 1048576
        keyManager:
          id: simplekeymanager
          config:
            subscriberId: "__CONSUMER_SUBSCRIBER_ID__"
            keyId: "__CONSUMER_KEY_ID__"
            signingPrivateKey: "__CONSUMER_SIGNING_PRIVATE__"
            signingPublicKey: "__CONSUMER_SIGNING_PUBLIC__"
            encrPrivateKey: "__CONSUMER_ENCR_PRIVATE__"
            encrPublicKey: "__CONSUMER_ENCR_PUBLIC__"
        signer:
          id: signer
        signValidator:
          id: signvalidator
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transaction_id,message_id
              role: bap
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: https://raw.githubusercontent.com/beckn/protocol-specifications-v2/refs/tags/core-v2.0.0-lts/api/v2.0.0/beckn.yaml
            cacheTTL: '3600'
            extendedSchema_enabled: "false"
            extendedSchema_cacheTTL: '86400'
            extendedSchema_maxCacheSize: '100'
            extendedSchema_downloadTimeout: '30'
            extendedSchema_allowedDomains: raw.githubusercontent.com,schema.beckn.io,schema.nfh.global,openagrinet.github.io
        router:
          id: router
          config:
            routingConfig: /app/config/routing-network-adapter-consumer.yaml
      steps:
        - validateSchema
        - addRoute

  # network-adapter: forwards discover and publish to discovery (routing-network.yaml).
  - name: network-adapter
    path: /_internal/network/
    handler:
      type: std
      role: bpp
      subscriberId: "__NETWORK_SUBSCRIBER_ID__"
      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            cacheTTL: 0
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            maxResponseBytes: 1048576
        keyManager:
          id: simplekeymanager
          config:
            subscriberId: "__NETWORK_SUBSCRIBER_ID__"
            keyId: "__NETWORK_KEY_ID__"
            signingPrivateKey: "__NETWORK_SIGNING_PRIVATE__"
            signingPublicKey: "__NETWORK_SIGNING_PUBLIC__"
            encrPrivateKey: "__NETWORK_ENCR_PRIVATE__"
            encrPublicKey: "__NETWORK_ENCR_PUBLIC__"
        signer:
          id: signer
        signValidator:
          id: signvalidator
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transaction_id,message_id
              role: bpp
        # Extended layer off: it fetches each resource's @context per payload.
        # The extendedSchema_* settings apply only when it is on.
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: "https://raw.githubusercontent.com/beckn/protocol-specifications-v2/refs/tags/core-v2.0.0-lts/api/v2.0.0/beckn.yaml"
            cacheTTL: "3600"
            extendedSchema_enabled: "false"
            extendedSchema_cacheTTL: "86400"
            extendedSchema_maxCacheSize: "100"
            extendedSchema_downloadTimeout: "30"
            extendedSchema_allowedDomains: "raw.githubusercontent.com,schema.beckn.io,schema.nfh.global,openagrinet.github.io"
        router:
          id: router
          config:
            routingConfig: /app/config/routing-network.yaml
      steps:
        - addRoute

  # oanProvider: answers from the upstream APIs itself (no router).
  - name: oanProvider
    path: /_internal/provider/
    handler:
      type: std
      role: bpp
      subscriberId: "__PROVIDER_SUBSCRIBER_ID__"
      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            cacheTTL: 0
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            maxResponseBytes: 1048576
        keyManager:
          id: simplekeymanager
          config:
            subscriberId: "__PROVIDER_SUBSCRIBER_ID__"
            keyId: "__PROVIDER_KEY_ID__"
            signingPrivateKey: "__PROVIDER_SIGNING_PRIVATE__"
            signingPublicKey: "__PROVIDER_SIGNING_PUBLIC__"
            encrPrivateKey: "__PROVIDER_ENCR_PRIVATE__"
            encrPublicKey: "__PROVIDER_ENCR_PUBLIC__"
        signValidator:
          id: signvalidator
        signer:
          id: signer
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transaction_id,message_id
              role: bpp
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: https://raw.githubusercontent.com/beckn/protocol-specifications-v2/refs/tags/core-v2.0.0-lts/api/v2.0.0/beckn.yaml
            cacheTTL: '3600'
            extendedSchema_enabled: "true"
            extendedSchema_allowedDomains: raw.githubusercontent.com,schema.beckn.io,schema.nfh.global,openagrinet.github.io
            extendedSchema_cacheTTL: '86400'
            extendedSchema_maxCacheSize: '100'
            extendedSchema_downloadTimeout: '30'
        mapper:
          id: jsonmapper
          config:
            fetchTimeout: 10s
            cacheTTL: 1m
            negativeTTL: 1m
            maxMappingBytes: 262144
            maxCacheEntries: 200
        providerSteps:
          - id: WeatherObservation
            config:
              bindingKeys: "__MAUSAMGRAM_BINDING_KEY__"
              __MAUSAMGRAM_PARTICIPANT_ID__:
                authScheme: header
                headerName: Authorization
                headerValueEnv: MAUSAMGRAM_AUTH
          - id: MandiPrice
            config:
              bindingKeys: "__AGMARKNET_BINDING_KEY__"
              __AGMARKNET_PARTICIPANT_ID__:
                authScheme: tokenQuery
                tokenUrl: "__AGMARKNET_TOKEN_URL__"
                tokenUserField: access_name
                tokenUserEnv: AGMARKNET_ACCESS_NAME
                tokenSecretField: password
                tokenSecretEnv: AGMARKNET_PASSWORD
                tokenResponseField: token
                queryName: token
                tokenTtl: 10m
          - id: KnowledgeAdvisory
            config:
              bindingKeys: "__VISTAAR_BINDING_KEY__"
              __VISTAAR_PARTICIPANT_ID__:
                authScheme: oauth2
                tokenUrl: "__VISTAAR_TOKEN_URL__"
                clientIdEnv: VISTAAR_CLIENT_ID
                clientSecretEnv: VISTAAR_CLIENT_SECRET
              maxResponseBytes: 1048576
          - id: AgricultureFacility
            config:
              bindingKeys: "__POCRA_BINDING_KEY__"
              __POCRA_PARTICIPANT_ID__:
                authScheme: none
              searchConcurrency: 1
      steps:
        - validateSchema
        - WeatherObservation
        - MandiPrice
        - KnowledgeAdvisory
        - AgricultureFacility

  # oanProviderPublish: the catalogue publishes at /publish; routed to
  # /_internal/network/publish (routing-network-adapter-provider.yaml).
  - name: oanProviderPublish
    path: /publish
    handler:
      type: std
      role: bap
      subscriberId: "__PROVIDER_SUBSCRIBER_ID__"
      plugins:
        registry:
          id: sunbirdRegistry
          config:
            url: http://sunbird-registry-service:8081/api/v1
            entity: Participant
            providerEntity: ProviderSchema
            cacheTTL: 0
            timeout: 2
            retry_max: 1
            retry_wait_min: 100ms
            retry_wait_max: 500ms
            maxResponseBytes: 1048576
        keyManager:
          id: simplekeymanager
          config:
            subscriberId: "__PROVIDER_SUBSCRIBER_ID__"
            keyId: "__PROVIDER_KEY_ID__"
            signingPrivateKey: "__PROVIDER_SIGNING_PRIVATE__"
            signingPublicKey: "__PROVIDER_SIGNING_PUBLIC__"
            encrPrivateKey: "__PROVIDER_ENCR_PRIVATE__"
            encrPublicKey: "__PROVIDER_ENCR_PUBLIC__"
        signer:
          id: signer
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transaction_id,message_id
              role: bap
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: https://raw.githubusercontent.com/beckn/protocol-specifications-v2/refs/tags/core-v2.0.0-lts/api/v2.0.0/beckn.yaml
            cacheTTL: '3600'
            extendedSchema_enabled: "true"
            extendedSchema_allowedDomains: raw.githubusercontent.com,schema.beckn.io,schema.nfh.global,openagrinet.github.io
            extendedSchema_cacheTTL: '86400'
            extendedSchema_maxCacheSize: '100'
            extendedSchema_downloadTimeout: '30'
        router:
          id: router
          config:
            routingConfig: /app/config/routing-network-adapter-provider.yaml
      steps:
        - validateSchema
        - addRoute
