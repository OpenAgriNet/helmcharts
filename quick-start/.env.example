# Copy to .env and fill in every <angle-bracketed> value. setup.py refuses to
# write to the registry while any is still a placeholder.
#
# A name's prefix says whose the value is: MAUSAMGRAM_/AGMARKNET_/VISTAAR_/
# POCRA_ are the upstreams, BECKN_NETWORK_/NETWORK_ the network itself.
#
# Every credential below is a shipped default, which means it is public. Change
# all of them before the stack is reachable by anyone but you. The network's
# keypair is the exception: setup.py generates it into keys/keys.json.

# ---- running a second network on one machine --------------------------------
# Empty for a single network. A second sets both, its own ports, its own
# BECKN_NETWORK_ID and its own NETWORK_BASE_URL -- then nothing collides.
STACK_NAME=openagrinet
STACK_PREFIX=

# Every port a second network has to move, because the first one holds it.
# Uncomment the block in that network's .env; the first keeps the defaults.
#STACK_NAME=oan-net-b
#STACK_PREFIX=b-
#REGISTRY_PORT=8082
#DISCOVERY_PORT=8091
#PROVIDER_ADAPTER_PORT=9210
#NETWORK_ADAPTER_PORT=9211
#CONSUMER_ADAPTER_PORT=9212
#MOCKIMD_PORT=9110
#MOCKAGMARKNET_PORT=9111
#REVERSE_PROXY_HTTP_PORT=8088
#REVERSE_PROXY_HTTPS_PORT=8443
#NPM_ADMIN_PORT=8181
#GRAFANA_UI_PORT=8086
#OTEL_COLLECTOR_OTLP_GRPC_PORT=4327
#OTEL_COLLECTOR_OTLP_HTTP_PORT=4328
#CLICKHOUSE_HTTP_PORT=8124

# ---- images ----------------------------------------------------------------
# Pinned, not latest, so what is deployed is in the diff. The adapter image and
# the adapter configs in this repo move together: a config names plugins by id
# and an id is a .so inside the image.
ADAPTER_IMAGE=ghcr.io/openagrinet/network-adapter:0.2.0-RC2
DISCOVERY_IMAGE=ghcr.io/openagrinet/discovery-service:0.2.0-RC1
# Source dir for `docker compose build discovery`; nothing else reads it.
DISCOVERY_CONTEXT=../../discovery-service
# That build's base images. Compose already defaults them to public ones because
# the Dockerfile's own dhi.io/* defaults 401 without a Hardened Images
# subscription. Uncomment only if you have one.
#DISCOVERY_BUILD_IMAGE=dhi.io/golang:1.27-alpine-dev
#DISCOVERY_RUNTIME_IMAGE=dhi.io/static:20260611-musl-alpine
# The two mock upstreams. No capability uses one; `make up` does not start them.
MOCKIMD_IMAGE=ghcr.io/nisargabd/oan-mockimd:latest
MOCKAGMARKNET_IMAGE=ghcr.io/nisargabd/oan-mockagmarknet:latest

# ---- ports -----------------------------------------------------------------
# All published on 127.0.0.1 except the reverse proxy's 80/443, and the loopback
# binding is written literally in docker-compose.yml rather than taken from a
# variable. Reach the rest over an SSH tunnel.
REGISTRY_PORT=8081
DISCOVERY_PORT=8090
PROVIDER_ADAPTER_PORT=9200
NETWORK_ADAPTER_PORT=9201
CONSUMER_ADAPTER_PORT=9202
# Only for looking at a mock directly; the adapter reaches it by service name.
MOCKIMD_PORT=9100
MOCKAGMARKNET_PORT=9101
# The reverse-proxy profile (nginx-proxy-manager). 80/443 are public, admin is not.
REVERSE_PROXY_HTTP_PORT=80
REVERSE_PROXY_HTTPS_PORT=443
NPM_ADMIN_PORT=81
# The observability profile (clickhouse, otel-collector, grafana).
GRAFANA_UI_PORT=8085
OTEL_COLLECTOR_OTLP_GRPC_PORT=4317
OTEL_COLLECTOR_OTLP_HTTP_PORT=4318
CLICKHOUSE_HTTP_PORT=8123

# ---- registry tier ---------------------------------------------------------
# The registry takes UNAUTHENTICATED writes. What keeps it private is the
# loopback binding and its absence from the proxy -- do not publish it.
REGISTRY_IMAGE_TAG=v2.0.0
# registry-db. Named REGISTRY_DB_ because discovery-db is a separate database.
REGISTRY_DB_NAME=registry
REGISTRY_DB_USER=postgres
REGISTRY_DB_PASSWORD=postgres

# ---- telemetry -------------------------------------------------------------
# Both components ship to this collector; a bare host:port, no scheme.
OTLP_ENDPOINT=otel-collector:4317
# The deployment name on every stream, from both components.
OTEL_ENVIRONMENT=dev
# ADAPTERS ONLY, all three signals. false builds no exporter and never dials --
# set it for `make up-core`, which does not start the observability profile.
ADAPTER_OTEL_ENABLED=true
# DISCOVERY ONLY, and a separate switch: `none` for `make up-core`.
DISCOVERY_OTEL_EXPORTER=otlp

# ClickHouse credentials, shared by the clickhouse, otel-collector and grafana
# containers -- the collector's exporter and Grafana's datasource both
# authenticate as this user. CHANGE the password before the stack is exposed.
CLICKHOUSE_DB=otel
CLICKHOUSE_USER=otel
CLICKHOUSE_PASSWORD=otel-changeme

# Grafana's own login -- unlike the HyperDX UI it replaces, Grafana has one.
# CHANGE the password before the stack is exposed; an Access List in front of
# the proxy host is a second layer, not a substitute for this.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-changeme
# The address Grafana is opened at; every link it sends out, the one in a Slack
# alert included, is built from it. Set it to the NPM hostname when Grafana is
# served through the proxy. Served under a path (https://host/grafana/) rather
# than a hostname of its own: GRAFANA_SERVE_FROM_SUB_PATH=true as well.
GRAFANA_ROOT_URL=http://127.0.0.1:8085/
GRAFANA_SERVE_FROM_SUB_PATH=false
# Exactly `true` or `false` -- it also names the directory alerting is loaded
# from, and `make up` / `make observability` refuse anything else. false for a
# stack nobody is on call for: dashboards work, nothing is evaluated or sent.
GRAFANA_ALERTING_ENABLED=true
# The Slack incoming webhook alerts are posted to. Left as the placeholder,
# alerts still evaluate and show in Grafana but every notification fails to
# send -- set this, or set GRAFANA_ALERTING_ENABLED=false.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/not-configured

# ---- discovery -------------------------------------------------------------
# Must be a DNS name -- the registry refuses a node id without a dot, and the
# Network Descriptor is served at https://<this>/.well-known/openagrinet.
#
# Pick it once: a deleted id is never reusable.
BECKN_NETWORK_ID=oan-dev.local
BECKN_SPEC_URL=https://raw.githubusercontent.com/OpenAgriNet/protocol-specifications-v2/refs/heads/release-0.2.0/api/v2.0.0/beckn.yaml
# Required when DISCOVERY_OTEL_EXPORTER is otlp: it attributes discovery's spans.
# Needs no keypair and no registry row -- discovery does not sign.
DISCOVERY_SUBSCRIBER_ID=discovery.oan.dev
# The sector. Checked against the build's sector list; every OAN component emits it.
DISCOVERY_DOMAIN=Agriculture
# GeoJSON shapes ONE catalog may add to the spatial index; past it, publish is
# PARTIAL and the excess is unsearchable. Count shapes, not resources.
#
# 50000 against the image's default of 256, because that number counts SHAPES
# while the cost it guards is incurred per H3 CELL -- and the two differ by up
# to 8192 apiece. A Point is one cell; a state-sized polygon is the ceiling. So
# a points-only catalog can raise this a long way and a polygon-heavy one
# cannot. The mandi catalog is 272 markets carrying a Point under both
# coverageAreas and market.location: 544 shapes, 544 cells, against the ~2.1M
# cells the default stands in for. Measured 2026-09-12 -- 50000 Points is
# roughly 3 s and 18 MB of index, so this is sized for where the catalog is
# going rather than where it is.
#
# RAISE IT BEFORE A BULK PUBLISH, not after. While a catalog is over the
# ceiling, republishing a resource that sits past the cut-off clears its
# geometry rows and writes none back -- it drops off the map silently.
#
# Interim: discovery-service#32 moves the budget onto cells, where it stops
# depending on what you publish and this line goes away.
DISCOVERY_MAX_GEOMETRIES_PER_CATALOG=50000
# Requests per second one client may make, and the bucket it may burst to.
# Effectively off: the image defaults to 20/40, which is under any scripted
# sweep, and a throttled request NACKs with AUT_RATE_LIMITED and no `catalogs`
# -- so it reads as an empty result, not as backpressure. Cannot be 0: the
# boot requires burst >= rps > 0.
DISCOVERY_RATE_LIMIT_RPS=100000
DISCOVERY_RATE_LIMIT_BURST=100000

# ---- the network's identity and federation ---------------------------------
# One entry for the whole network, shared by all three adapters with ONE
# keypair. The KEY's osid is the key id, not the entry's.
BECKN_NETWORK_NAME=OAN Dev
# Where the network layer is reached: published in the registry entry, and the
# descriptor's services.discovery is this plus /discover.
#
# NO PATH. The edge maps /discover onto the /network/ mount. The mount name is
# ours; nobody else should carry it.
NETWORK_BASE_URL=https://oan-dev.local
# Seconds another network may keep what it crawls from this one, published in
# the Network Descriptor. Optional; omitted from the descriptor when unset.
FEDERATION_PROJECTION_TTL=30

# ---- the crawler -----------------------------------------------------------
# off means this network never crawls; answering someone else's crawl is
# unaffected. On, it crawls the networks admitted with a `source` direction.
FEDERATION_CRAWL_PEERS=off
# How often every admitted network is asked, in seconds.
FEDERATION_REFRESH_SECONDS=900
# How many catalogs one call asks for. Discovery's own default is 20, so
# without this a network sharing more is only partly collected and nothing
# says so.
FEDERATION_PAGE_SIZE=100
# What breadth of another network's catalogue to ask for. Required when the
# crawler is on: discovery refuses an intent that narrows nothing, so leaving
# it empty mirrors zero catalogs with no error anywhere. The star does the
# work, and isActive is the one field every catalog has.
FEDERATION_INTENT={"filters": {"type": "jsonpath", "expression": "$.catalogs[*] ? (@.isActive == true)"}}

# ---- the four upstream providers -------------------------------------------
# setup.py creates all four plus a capability binding each -- five participants
# (the network itself and these four) and four bindings in all. The registry is
# unreachable from outside the stack, so there is no second way to create them.
#
# THE BINDING KEY IS <PARTICIPANT_ID>|<CAPABILITY>. The provider adapter builds
# it from the incoming payload and matches it against its own config; setup.py
# renders that config AND seeds the registry from these same values, which is
# what keeps the two from disagreeing. Change one, re-run setup.py.
# A mismatch is a 404, either NET_ENTITY_NOT_FOUND or "no active record".
#
# All four are REAL external APIs -- the stack needs egress to each.

# WeatherObservation, from IMD Mausamgram. One ready-made header value, "Basic "
# prefix included, sent verbatim (authScheme header) -- IMD issues a single
# opaque token, not a user/password pair.
MAUSAMGRAM_PARTICIPANT_ID=mausamgram
MAUSAMGRAM_CAPABILITY=openagrinet:WeatherObservation
MAUSAMGRAM_BASE_URL=https://mausamgram.imd.gov.in
MAUSAMGRAM_PATH=/nwpapi/get-daily
MAUSAMGRAM_AUTH=<the whole header value IMD gave you, e.g. Basic eyJhb...>
MAUSAMGRAM_MAPPING_URL=https://raw.githubusercontent.com/OpenAgriNet/helmcharts/0.1.0/quick-start/config/mappings/mausamgram/weather-observation.select.yaml

# MandiPrice, from Agmarknet. authScheme tokenQuery: the adapter POSTs the
# access name and password to the token URL and sends the token it gets back as
# a query parameter. Those two reach the adapter as environment variables only.
# TOKEN_URL IS ABSOLUTE, not a path: it is rendered into the config verbatim and
# POSTed as given, so a bare path fails with unsupported protocol scheme "".
# KNOWN AND UNFIXED: "no records" comes back as HTTP 400, which the adapter
# treats as permanent -- so an empty market reads as ERROR, not "no prices".
AGMARKNET_PARTICIPANT_ID=agmarknet
AGMARKNET_CAPABILITY=openagrinet:MandiPrice
AGMARKNET_BASE_URL=<the Agmarknet base URL>
AGMARKNET_PATH=/v1/fetch-agmarknet-vistaar
AGMARKNET_TOKEN_URL=<the Agmarknet token endpoint, absolute: http://host:port/path>
AGMARKNET_ACCESS_NAME=<the Agmarknet access name>
AGMARKNET_PASSWORD=<the Agmarknet password>
AGMARKNET_MAPPING_URL=https://raw.githubusercontent.com/OpenAgriNet/helmcharts/0.1.0/quick-start/config/mappings/agmarknet/mandi-price.select.yaml

# KnowledgeAdvisory, from Bharat Vistaar -- the entity that runs the corpus, not
# the docs-pipeline that filled it. authScheme oauth2 client credentials, and a
# POST. The two secrets reach the adapter as environment variables only.
VISTAAR_PARTICIPANT_ID=bharat-vistaar
VISTAAR_CAPABILITY=openagrinet:KnowledgeAdvisory
VISTAAR_BASE_URL=<the Bharat Vistaar base URL>
VISTAAR_PATH=/docs-pipeline-api/search
VISTAAR_TOKEN_URL=<the Bharat Vistaar OAuth2 token endpoint>
VISTAAR_CLIENT_ID=<the service account client id>
VISTAAR_CLIENT_SECRET=<the service account secret>
VISTAAR_MAPPING_URL=https://raw.githubusercontent.com/OpenAgriNet/helmcharts/0.1.0/quick-start/config/mappings/knowledge/knowledge-advisory.select.yaml

# AgricultureFacility, from POCRA. A POST, and the only capability needing no
# credential -- its registry row publishes authScheme none.
# TWO MEASURED BEHAVIOURS: it takes exactly ONE facility type per call and
# caches on message_id for ten minutes while IGNORING location; and after ~20
# calls it answers 200 with an empty catalogue, indistinguishable from "nothing
# nearby". That is why searchConcurrency is pinned to 1. Do not raise it.
POCRA_PARTICIPANT_ID=pocra
POCRA_CAPABILITY=openagrinet:AgricultureFacility
POCRA_BASE_URL=https://middleware-bap-client.mahapocra.gov.in
POCRA_PATH=/search
POCRA_MAPPING_URL=https://raw.githubusercontent.com/OpenAgriNet/helmcharts/0.1.0/quick-start/config/mappings/pocra/agriculture-facility.select.yaml

# single-adapter: network-adapter runs all three tiers; multi-adapter: the network tier plus
# provider- and consumer-adapter. Unset means single-adapter; the shell's value overrides this one.
NETWORK_ADAPTER_DEPLOYMENT_MODE=single-adapter
# Plain `docker compose up -d` follows the mode too: multi-adapter is also the profile.
COMPOSE_PROFILES=${NETWORK_ADAPTER_DEPLOYMENT_MODE:-single-adapter}

# ---- PM-KISAN -----------------------------------------------------------
# Two capabilities on two hosts. Optional: leave the hosts as placeholders and
# `make register-provider PROVIDER=pmkisan` is the only thing that refuses.
PMKISAN_PARTICIPANT_ID=pmkisan
PMKISAN_BASE_URL=<the PM-KISAN grievance host>
PMKISAN_CHATBOT_BASE_URL=<the PM-KISAN chatbot host, where application status lives>
PMKISAN_MAPPING_BASE_URL=https://raw.githubusercontent.com/OpenAgriNet/helmcharts/0.1.0/quick-start/config/mappings/pmkisan
# Read at call time by the adapter, never stored in the registry.
PMKISAN_GRIEVANCE_KEY=<the AES key PM-KISAN issued>
PMKISAN_GRIEVANCE_IV=<its nonce>
PMKISAN_SERVICE_TOKEN=<the grievance service token>
PMKISAN_OTP_TOKEN=<the OTP service token>
